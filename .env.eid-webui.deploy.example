# Hermes WebUI deployment template for an existing EID + Hermes Agent server.
# The Windows package script copies this to release/hermes-webui-eid/deploy.env.
# Edit deploy.env on the Linux server before running bash deploy.sh.
#
# This stack only starts Hermes WebUI. Hermes Agent/Gateway and EID frontend are
# expected to be packaged and deployed separately, then attached to eid-2-net.

HERMES_WEBUI_IMAGE=hermes-webui-eid:latest
HERMES_WEBUI_CONTAINER_NAME=hermes-webui-eid
EID_DOCKER_NETWORK=eid-2-net

# WebUI host port. Keep localhost binding when EID reverse-proxies/embeds WebUI.
HERMES_WEBUI_HOST_BIND=127.0.0.1
HERMES_WEBUI_HOST_PORT=8787

# Host UID/GID for mounted workspace/state. The deploy script fills these when empty.
HERMES_HOST_UID=1000
HERMES_HOST_GID=1000

# Shared workspace mounted into the container at /workspace.
HERMES_WORKSPACE=/opt/eid-hermes/workspace

# Browser origin allowed to iframe /chatbot.
# Set this to the already deployed EID frontend origin, for example:
#   https://eid.example.com
#   http://10.0.0.12:8080
HERMES_WEBUI_EMBED_ALLOWED_ORIGIN=http://localhost:8080

# Existing Hermes Agent Gateway reachable from inside the WebUI container.
# If hermes-agent is attached to eid-2-net with service/container name
# "hermes-agent", this default works. Otherwise set the real network alias.
HERMES_WEBUI_CHAT_BACKEND=gateway
HERMES_WEBUI_GATEWAY_BASE_URL=http://eid_2_hermes:8642

# Must match the API_SERVER_KEY configured in the separately deployed backend.
HERMES_WEBUI_GATEWAY_API_KEY=abf3ab2aade20544349f2f822ebc413a69925303461f169e3f6ecccb2f68a7bd
HERMES_WEBUI_GATEWAY_TRANSPORT=runs

# EID record-only embedded chat.
HERMES_WEBUI_EID_RECORD_CONTEXT=1

# Keep empty only when WebUI is reachable solely through trusted EID/reverse proxy paths.
HERMES_WEBUI_PASSWORD=

# Optional mirror for runtime dependency installation.
UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
